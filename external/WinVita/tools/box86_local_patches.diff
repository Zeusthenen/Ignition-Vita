+    if(!dyn86_nopend) return 1;
+    if(dyn86_nopend == 3) { ++dyn86_nopend_dropped; return 0; }
+    if(dyn86_nopend == 1 && d2_nopend_is_call(dyn, ninst)) {
+        ++dyn86_nopend_dropped; return 0; }
+    ++dyn86_nopend_kept; return 1;
+}
