+/* Etat de chaine : remis a neuf au debut de CHAQUE passe (arm_pass). */
+#define D2MMUST_RESET(d)  do{ (d)->mmust_ninst = -1; (d)->mmust_pos = -1; \
+                              (d)->mmust_kind = 0; (d)->mmust_scr = -1;   \
+                              (d)->mmust_delta = 0; }while(0)
+
+#endif //__DYNAREC_ARM_MMU_H_
